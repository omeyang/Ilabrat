{
  "name": "@omeyang/dsh-ilabrat",
  "version": "0.1.0",
  "description": "Buf workspace checks and schema-backed gRPC calls for DeepSeek Harness",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.9.0"
  },
  "exports": {
    ".": "./src/plugin.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "ilabrat": "./src/cli.js"
  },
  "files": [
    "src",
    "locale",
    "icon.svg",
    "cordis.patch.yml",
    "README.md",
    "client.js"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  },
  "scripts": {
    "test": "node --test",
    "build": "node scripts/build.mjs"
  },
  "devDependencies": {
    "esbuild": "0.27.7"
  }
}
